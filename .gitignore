# Generated outputs
/media/*/out/
/system_media/*.mp4

# Inputs (example vision)
/media/*/source/raw/*
!/media/*/source/raw/.gitkeep

# Local sync config (do not commit)
/media/*/config/sync_media.env
/media/*/config/push_media.env

# Python
__pycache__/
*.pyc
.venv/

# Windows download metadata
*:Zone.Identifier
