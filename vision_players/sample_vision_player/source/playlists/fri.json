{
  "meta": {
    "default_volume": 100,
    "default_loop": true,
    "default_start_offset_sec": 0
  },
  "auto_policy": {
    "directory": "media/fri",
    "mode": "append_remaining",
    "sort": "asc",
    "extensions": [
      ".mp4",
      ".png",
      ".jpg",
      ".webm"
    ]
  },
  "lanes": {
    "lane0": {
      "lane_policy": {
        "fill": "contain",
        "anchor": "center"
      },
      "items": [
        {
          "source": "media/always/sample_video_01.mp4"
        },
        {
          "source": "media/always/sample_image_01.jpg",
      ".webm",
          "duration_sec": 12
        },
        {
          "source": "media/always/sample_video_02.mp4"
        }
      ]
    },
    "lane1": {
      "lane_policy": {
        "fill": "contain",
        "anchor": "center"
      },
      "items": [
        {
          "source": "media/always/sample_video_03.mp4"
        },
        {
          "source": "media/always/sample_image_02.png",
          "duration_sec": 12
        },
        {
          "source": "media/always/sample_video_04.mp4"
        }
      ]
    },
    "lane2": {
      "lane_policy": {
        "fill": "contain",
        "anchor": "center"
      },
      "items": [
        {
          "source": "media/always/sample_video_05.mp4"
        },
        {
          "source": "media/always/sample_image_03.jpg",
      ".webm",
          "duration_sec": 12
        }
      ]
    }
  }
}