{
  "meta": {
    "default_volume": 100,
    "default_loop": true,
    "default_start_offset_sec": 0
  },
  "lanes": {
    "lane0": {}
  },
  "active_time": {
    "always": {
      "from": "10:00",
      "until": "20:00"
    }
  },
  "auto_policy": {
    "directory": "media/always",
    "sort": "asc",
    "mode": "append_remaining",
    "extensions": [
      ".mp4",
      ".mov",
      ".m4v",
      ".mkv",
      ".webm",
      ".avi",
      ".mpg",
      ".mpeg",
      ".png",
      ".jpg",
      ".jpeg",
      ".bmp",
      ".webp"
    ]
  }
}